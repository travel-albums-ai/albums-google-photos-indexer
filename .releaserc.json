{
  "branches": ["main"],
  "repositoryUrl": "https://github.com/travel-albums-ai/albums-google-photos-indexer.git",

  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],

    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "🚀 Features"
            },
            {
              "type": "fix",
              "section": "🐛 Bug Fixes"
            },
            {
              "type": "perf",
              "section": "⚡ Performance"
            },
            {
              "type": "refactor",
              "section": "🧹 Refactoring"
            },
            {
              "type": "docs",
              "section": "📚 Documentation"
            },
            {
              "type": "build",
              "section": "📦 Build & Packaging"
            },
            {
              "type": "ci",
              "section": "🤖 CI/CD"
            }
          ]
        },
        "writerOpts": {
          "commitsSort": [
            "scope",
            "subject"
          ]
        }
      }
    ],

    "@semantic-release/changelog",

    "@semantic-release/npm",

    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "TravelAlbums-windows-arm64.zip",
            "label": "Windows ARM64"
          },
          {
            "path": "TravelAlbums-windows-x64.zip",
            "label": "Windows x64"
          },
          {
            "path": "TravelAlbums-macos-arm64.tar.gz",
            "label": "macOS Apple Silicon"
          },
          {
            "path": "TravelAlbums-macos-x64.tar.gz",
            "label": "macOS Intel"
          },
          {
            "path": "TravelAlbums-ubuntu-arm64.tar.gz",
            "label": "Ubuntu ARM64"
          },
          {
            "path": "TravelAlbums-ubuntu-x64.tar.gz",
            "label": "Ubuntu x64"
          },
          {
            "path": "SHA256SUMS",
            "label": "SHA-256 Checksums"
          }
        ]
      }
    ],

    [
      "@semantic-release/git",
      {
        "assets": [
          "package.json",
          "CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
