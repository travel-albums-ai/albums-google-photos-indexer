{
  "name": "albums-google-photos-indexer",
  "version": "1.25.0",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "prestart": "bun run build",
    "start": "node dist/server.mjs --config server-config.json",
    "start:win": "node dist/server.mjs --config server-config-win.json",
    "indexer": "time node indexer-cli.mjs --config server-config.json",
    "test:programmatic": "node ./test/programmatic-test.mjs",
    "build": "bun x esbuild server.mjs --bundle --platform=node --format=esm --target=node18 --outfile=dist/server.mjs --minify --sourcemap --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url); globalThis.__INDEXER_IMPORTED_IN_SERVER__ = true;\" && bun x esbuild indexer-cli.mjs --bundle --platform=node --format=esm --target=node18 --outfile=dist/indexer-cli.mjs --minify --sourcemap --external:sharp && mkdir -p dist/src/indexer/data && cp -r src/indexer/data/* dist/src/indexer/data/",
    "pack": "bun pm pack",
    "prepack": "bun run build",
    "prepublishOnly": "bun run build",
    "ship": "bun run pack && npm publish --access public",
    "dist:arm64": "bun scripts/package-node-dist.mjs arm64 dist-arm64",
    "dist:x64": "bun scripts/package-node-dist.mjs x64 dist-x64",
    "dist:package": "bun run dist:arm64 && bun run dist:x64",
    "next": "semantic-release",
    "powershell:arm64": "cd ./dist-arm64 && powershell -ExecutionPolicy Bypass -File launcher.ps1"
  },
  "main": "dist/indexer-cli.mjs",
  "files": [
    "indexer-cli.mjs",
    "server.mjs",
    "run-arm64.cmd",
    "run-x64.cmd",
    "launcher.ps1",
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "examples/"
  ],
  "bin": {
    "indexer": "dist/indexer-cli.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/indexer-cli.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "Travel Albums",
  "repository": {
    "type": "git",
    "url": "https://github.com/travel-albums-ai/albums-google-photos-indexer.git"
  },
  "bugs": {
    "url": "https://github.com/travel-albums-ai/albums-google-photos-indexer/issues"
  },
  "homepage": "https://github.com/travel-albums-ai/albums-google-photos-indexer#readme",
  "keywords": [
    "photos",
    "indexer",
    "takeout",
    "thumbnails",
    "ndjson"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "driver.js": "^1.8.0",
    "express": "^5.1.0",
    "p-limit": "^7.3.1",
    "sharp": "^0.35.3"
  },
  "bundledDependencies": [
    "sharp"
  ],
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.1.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.19.12",
    "globals": "^17.8.0",
    "semantic-release": "^24.2.9"
  },
  "bundleDependencies": [
    "sharp"
  ]
}
