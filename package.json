{
  "name": "albums-google-photos-indexer",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "indexer": "time node indexer-cli.mjs --config server-config.json",
    "test:programmatic": "node ./test/programmatic-test.mjs",
    "pack": "npm pack",
    "ship": "npm run pack && npm publish --access public"
  },
  "main": "indexer-cli.mjs",
  "files": [
    "indexer-cli.mjs",
    "src/",
    "README.md",
    "LICENSE",
    "examples/"
  ],
  "bin": {
    "indexer": "indexer-cli.mjs"
  },
  "exports": {
    ".": {
      "import": "./indexer-cli.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "Travel Albums",
  "repository": {
    "type": "git",
    "url": "https://github.com/travel-albums-ai/albums-google-photos-indexer.git"
  },
  "bugs": {
    "url": "https://github.com/travel-albums-ai/albums-google-photos-indexer/issues"
  },
  "homepage": "https://github.com/travel-albums-ai/albums-google-photos-indexer#readme",
  "keywords": ["photos","indexer","takeout","thumbnails","ndjson"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "driver.js": "^1.8.0",
    "p-limit": "^7.3.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.1.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "globals": "^17.8.0",
    "semantic-release": "^24.2.9"
  }
}
