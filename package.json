{
  "name": "albums-google-photos-indexer",
  "version": "1.52.0",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "prestart": "bun run build",
    "start": "bun dist/server.mjs",
    "start:win": "bun dist/server.mjs --config server-config-win.json",
    "indexer": "INDEXER_CLI_ENTRYPOINT=true time bun indexer-cli.mjs --config server-config.json",
    "test:programmatic": "bun ./test/programmatic-test.mjs",
    "build": "bun x esbuild server.mjs --bundle --platform=node --format=esm --target=node18 --outfile=dist/server.mjs --minify --define:globalThis.__INDEXER_CLI_ENTRYPOINT__=false --define:globalThis.__SERVER_ENTRYPOINT__=true && bun x esbuild indexer-cli.mjs --bundle --platform=node --format=esm --target=node18 --outfile=dist/indexer-cli.mjs --minify --define:globalThis.__INDEXER_CLI_ENTRYPOINT__=true && mkdir -p dist/src/indexer/data && cp -r src/indexer/data/* dist/src/indexer/data/",
    "pack": "bun pm pack",
    "prepack": "bun run build",
    "prepublishOnly": "bun run build",
    "ship": "bun run pack && npm publish --access public",
    "dist:windows-arm64": "bun scripts/package-bun-dist.mjs windows arm64",
    "dist:windows-x64": "bun scripts/package-bun-dist.mjs windows x64",
    "dist:windows": "concurrently \"bun run dist:windows-arm64\" \"bun run dist:windows-x64\"",
    "dist:macos-arm64": "bun scripts/package-bun-dist.mjs macos arm64",
    "dist:macos-x64": "bun scripts/package-bun-dist.mjs macos x64",
    "dist:macos": "concurrently \"bun run dist:macos-arm64\" \"bun run dist:macos-x64\"",
    "dist:ubuntu-arm64": "bun scripts/package-bun-dist.mjs ubuntu arm64",
    "dist:ubuntu-x64": "bun scripts/package-bun-dist.mjs ubuntu x64",
    "dist:ubuntu": "concurrently \"bun run dist:ubuntu-arm64\" \"bun run dist:ubuntu-x64\"",
    "dist:package": "concurrently \"bun run dist:windows\" \"bun run dist:macos\" \"bun run dist:ubuntu\"",
    "distribute": "bun run build && bun run dist:package",
    "next": "semantic-release",
    "delete:archives": "rm -f TravelAlbums-windows-* TravelAlbums-macos-* TravelAlbums-ubuntu-*",
    "delete": "bun run delete:archives && rm -rf dist-windows-* dist-macos-* dist-ubuntu-* dist"
  },
  "main": "dist/indexer-cli.mjs",
  "files": [
    "indexer-cli.mjs",
    "server.mjs",
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "examples/"
  ],
  "bin": {
    "indexer": "dist/indexer-cli.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/indexer-cli.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "Travel Albums",
  "repository": {
    "type": "git",
    "url": "https://github.com/travel-albums-ai/albums-google-photos-indexer.git"
  },
  "bugs": {
    "url": "https://github.com/travel-albums-ai/albums-google-photos-indexer/issues"
  },
  "homepage": "https://github.com/travel-albums-ai/albums-google-photos-indexer#readme",
  "keywords": [
    "photos",
    "indexer",
    "takeout",
    "thumbnails",
    "ndjson"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "driver.js": "^1.8.0",
    "express": "^5.1.0",
    "p-limit": "^7.3.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.19.12",
    "globals": "^17.8.0",
    "semantic-release": "^24.2.9",
    "semver": "^7.8.5"
  },
  "bundleDependencies": []
}
